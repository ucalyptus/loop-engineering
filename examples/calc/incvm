#!/usr/bin/env bash
# incvm CMD... — run a check inside a throwaway container ("hands inside").
# The current directory is shared read-only at /work; no network; the container is deleted after.
# The exit code of CMD is passed through, so loopctl sees pass/fail as usual.
# Runtime: INCVM_RUNTIME=docker (default; any OS with Docker) or INCVM_RUNTIME=container
# (Apple's `container` CLI, one microVM per check, Apple Silicon only: https://github.com/apple/container).
# Override the image with INCVM_IMAGE (default python:3.12-slim).
set -euo pipefail
[[ $# -gt 0 ]] || { echo "usage: incvm CMD..." >&2; exit 2; }
runtime="${INCVM_RUNTIME:-docker}"
case "$runtime" in
  docker) quiet=(--quiet) ;;
  container) quiet=(--progress none) ;;
  *) echo "incvm: INCVM_RUNTIME must be docker or container, got '$runtime'" >&2; exit 2 ;;
esac
command -v "$runtime" >/dev/null || { echo "incvm: '$runtime' CLI not found" >&2; exit 127; }
exec "$runtime" run --rm "${quiet[@]}" \
  --network none \
  -v "$PWD":/work:ro -w /work \
  -e PYTHONDONTWRITEBYTECODE=1 \
  "${INCVM_IMAGE:-python:3.12-slim}" "$@"
