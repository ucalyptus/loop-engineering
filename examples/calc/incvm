#!/usr/bin/env bash
# incvm CMD... — run a check inside a throwaway Apple container VM ("hands inside").
# The current directory is shared read-only at /work; no network; the VM is deleted after.
# The exit code of CMD is passed through, so loopctl sees pass/fail as usual.
# Requires Apple Silicon + Apple's `container` CLI (https://github.com/apple/container).
# Override the image with INCVM_IMAGE (default python:3.12-slim).
set -euo pipefail
[[ $# -gt 0 ]] || { echo "usage: incvm CMD..." >&2; exit 2; }
command -v container >/dev/null || { echo "incvm: Apple 'container' CLI not found" >&2; exit 127; }
exec container run --rm --progress none \
  --network none \
  -v "$PWD":/work:ro -w /work \
  -e PYTHONDONTWRITEBYTECODE=1 \
  "${INCVM_IMAGE:-python:3.12-slim}" "$@"
